{
  "name": "zhe-port-link-demo",
  "version": "1.0.0",
  "private": true,
  "description": "港航智能业务系统（三防预警系统）",
  "scripts": {
    "dev": "concurrently \"npm run dev:mock\" \"npm run dev:front\"",
    "dev:front": "cd front && npx vite",
    "dev:mock": "cd mock-server && npx tsx watch src/index.ts",
    "build": "cd front && npx tsc && npx vite build",
    "install:all": "npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.21.3",
    "recharts": "^2.10.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
